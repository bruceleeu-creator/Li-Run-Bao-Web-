__pycache__/
*.py[cod]
*.egg-info/
*.egg
dist/
build/
.eggs/

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Excel 临时锁文件（Office 打开时生成）
~$*.xlsx
.~*.xlsx

# pytest 缓存
.pytest_cache/

# 本地工具/代理状态（不入库）
.claude/
.superpowers/
.scratch/
/test-results/

# 发布包产物（不入库，本地构建）
release/

# Virtual env
venv/
.venv/
env/

# Web 前端依赖与产物
node_modules/
web_frontend/dist/
web_frontend/test-results/
web_frontend/playwright-report/

# Web 后端本地工作区（用户上传文件、运行时 DB，不入库）
# 用内容通配而非目录忽略，便于放行 e2e 必需夹具
web_backend/workspaces/*
!web_backend/workspaces/2021年审计报告.xlsx
!web_backend/workspaces/2022年审计报告.xlsx
!web_backend/workspaces/2023年审计报告.xlsx

# 运行时 SQLite（根目录误生成的空库同样不入库）
app.db
*.db.lock

# Output
# demo_output/ 默认全部忽略，仅精确放行正式发布的示例产物（xlsx/docx/pdf/png）
demo_output/*
!demo_output/.gitkeep
!demo_output/sample_finance.xlsx
!demo_output/trend.png
!demo_output/budget_3sheet_WB-CO-TR-20260726.xlsx
!demo_output/budget_report_WB-CO-TR-20260726.docx
!demo_output/budget_report_WB-CO-TR-20260726.pdf
# Phase B 案例清单与对标金标（可提交）
!demo_output/cases/
!demo_output/cases/**
# e2e 必需夹具（docx/pdf 预览用，make_sample 派生的合成数据）
!demo_output/样例财报_WB-CO-TR-20260805.docx
!demo_output/样例财报中文_WB-CO-TR-20260805.pdf


# Config
*.env
config.local.py
# 大模型配置文件（含 API Key，禁止入库；gui.py 仅在内存中持有 Key）
.ai_config.json
.ai_config.local.json

# Logs
*.log

# OCR 高精度模型文件（体积大、离线手动放置，不入库；见 core/parser.py _OCR_MODEL_DIR）
models/*.onnx

# Mimosa 扫描运行时产物（不入库）
.mimosa/
